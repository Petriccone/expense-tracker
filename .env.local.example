NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — server-side only. Used by /api/* routes if you add them.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional — for AI categorization feature
OPENAI_API_KEY=sk-...

# TrueLayer (optional — only needed for /api/truelayer/*)
# Get these from https://console.truelayer.com → your app → Settings
TRUELAYER_CLIENT_ID=sandbox-expensetracker-xxxxxxxx
TRUELAYER_CLIENT_SECRET=tlcs_sandbox_...
TRUELAYER_ENV=sandbox   # sandbox | live

# Where SQLite stores tokens + cached transactions. Defaults to ./data
# locally and /data in production. Mount a Dokploy volume on /data for
# persistence across redeploys.
# PETRICCO_DATA_DIR=/data

# Stable id until real auth is wired in.
# PETRICCO_USER_ID=default