NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — server-side only. Used by /api/* routes if you add them.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional — for AI categorization feature
OPENAI_API_KEY=sk-...

# GoCardless Bank Account Data (formerly Nordigen) — the bank aggregator.
# Covers Irish banks (Revolut, AIB, Bank of Ireland, etc.). Get these from
# https://bankaccountdata.gocardless.com → User Secrets (create a secret).
GOCARDLESS_SECRET_ID=your-secret-id-uuid
GOCARDLESS_SECRET_KEY=your-secret-key-long-string

# Encrypts the stored GoCardless requisition/token at rest in SQLite
# (AES-256-GCM). 32 bytes as 64 hex chars, or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production this MUST be set (the app refuses to store plaintext).
TRUELAYER_TOKEN_ENC_KEY=

# Shared secret for the machine/cron sync endpoint (x-cron-secret header on
# POST /api/gocardless/sync, POST /api/banking/sync). In production this
# MUST be set.
INTERNAL_API_SECRET=

# Enable Banking (https://api.enablebanking.com) — used for Revolut (IE).
# Get these by registering an app at https://enablebanking.com/cp/.
# ENABLE_BANKING_APP_ID is the application_id (also the JWT `kid`).
# ENABLE_BANKING_PRIVATE_KEY is the PEM contents of the matching RSA private
# key — the ONLY crown-jewel secret here. Never log or commit it.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=

# Where SQLite stores tokens + cached transactions. Defaults to ./data
# locally and /data in production. Mount a Dokploy volume on /data for
# persistence across redeploys.
# PETRICCO_DATA_DIR=/data

# Stable id until real auth is wired in.
# PETRICCO_USER_ID=default